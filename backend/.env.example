PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/zammarket
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
FRONTEND_URL=http://localhost:5173

# SMS for registration codes: console | africastalking | twilio
# console prints the code in the server log (free; for development)
SMS_PROVIDER=console
# Africa's Talking (https://account.africastalking.com) - use AT_USERNAME=sandbox to test with the simulator
AT_USERNAME=
AT_API_KEY=
# Optional registered sender ID; leave empty to use the shared default
AT_SENDER_ID=
# Twilio (https://console.twilio.com) - trial accounts only reach numbers you have verified
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
